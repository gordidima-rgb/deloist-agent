# Ключ для api-драйвера. Можно вписать здесь или в настройках в интерфейсе.
# Подходит любой OpenAI-совместимый провайдер.
OPENAI_API_KEY=

# Примеры:
# OPENAI_API_KEY=sk-...
# baseUrl в настройках: https://api.openai.com/v1
#
# OPENAI_API_KEY=sk-or-...
# baseUrl: https://openrouter.ai/api/v1  ·  модель: anthropic/claude-sonnet-4
#
# OPENAI_API_KEY=sk-...
# baseUrl: https://api.deepseek.com/v1  ·  модель: deepseek-chat

# Порт и папка данных (необязательно)
# PORT=8899
# CREW_DATA_DIR=C:\X\crew\data
